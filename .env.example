NODE_ENV=development
PORT=3000
DATABASE_URL=postgres://realbite:realbite@localhost:5432/realbite
# HS256 access-token signing key. >=32 chars; generate with `openssl rand -base64 32`.
JWT_SECRET=
# Optional: debug | info | warn | error. Default: info in production, silent under test, debug otherwise.
# LOG_LEVEL=debug
# Log every SQL statement at debug level (text only) to spot N+1s and missing indexes.
# DB_LOG_QUERIES=true
# Comma-separated browser origins allowed by CORS (admin SPA). Empty = none.
CORS_ORIGINS=
